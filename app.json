{
  "expo": {
    "name": "SkyScout",
    "slug": "sky",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050714",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kartiik.skyscout",
      "infoPlist": {
        "NSCameraUsageDescription": "SkyScout needs camera access to overlay celestial stars and constellations onto the night sky.",
        "NSLocationWhenInUseUsageDescription": "SkyScout requires your location to calculate which stars and planets are visible from your position.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kartiik.skyscout",
      "adaptiveIcon": {
        "backgroundColor": "#050714",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bd9a8756-f370-41a9-aad6-faefc41e82f1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bd9a8756-f370-41a9-aad6-faefc41e82f1"
    }
  }
}
